# Configuration YGG-Scrappey
# Renommez ce fichier en .env et remplissez les valeurs

# Clé API Scrappey (obtenir sur scrappey.com)
SCRAPPEY_KEY=your_scrappey_key_here

# Cookie YGG (voir README pour obtenir le cookie)
# Format: yggxf_user=XXX; yggxf_csrf=XXX; yggxf_session=XXX; ygg_=XXX
YGG_COOKIE=your_complete_ygg_cookie_here

# Proxy HTTP (optionnel)
HTTP_PROXY=

# IP du serveur (pour Prowlarr)
SERVER_IP=localhost